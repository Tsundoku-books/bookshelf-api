# Server
PORT=3000
NODE_ENV=development

# Database (local, via docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookshelf
DB_USER=admin
DB_PASSWORD=admin123

# Database (hosted, e.g. Supabase) - takes precedence over the DB_* vars when set
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# CORS - comma-separated list of allowed origins
# CORS_ORIGIN=https://<user>.github.io

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Comma-separated emails granted the admin role on register/login
# ADMIN_EMAILS=admin@example.com

# Log verbosity: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# Optional: PEM of the CA that signs the database certificate, to verify the server
# DATABASE_CA_CERT=
# Optional: set to false to hide Swagger UI at /api-docs
# API_DOCS_ENABLED=true
